# ---- DeepSeek ----
# 必填。只在服务端读取，绝不会下发到浏览器。
DEEPSEEK_API_KEY=

# 可选，默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选。按你账号实际可用的模型名填，例如 deepseek-chat / deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# 可选，0 ~ 1.5。数字分身要稳，建议 0.8 左右。
DEEPSEEK_TEMPERATURE=0.8

# 可选，单次回复最大 token。太长会变得像客服小作文。
DEEPSEEK_MAX_TOKENS=600

# ---- 服务 ----
PORT=8787

# 静态目录，相对项目根。填 ../publish-site 就能边改边看线上同款页面。
STATIC_DIR=../publish-site

# 允许跨域的来源，逗号分隔。留空表示同源即可。
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# 每个 IP 每分钟最多提问次数
RATE_LIMIT_PER_MIN=12

# 会话里最多带几轮历史（1 轮 = 一问一答）
MAX_HISTORY_TURNS=8

# 没有 Key 时是否用本地演示回复（true 时不请求模型，仅用于联调 UI）
MOCK_MODE=auto
